{
  "name": "cue",
  "version": "0.4.1",
  "description": "Cue: a small window beside your call that transcribes both sides, reads the shared screen, suggests what to say from your own material, and writes the call up when it ends.",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/core.test.js",
    "e2e": "node test/e2e.js",
    "dist": "electron-builder --publish never"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "electron-updater": "^6.8.9",
    "mammoth": "^1.13.0",
    "onnxruntime-web": "^1.30.0",
    "tesseract.js": "^7.0.0",
    "unpdf": "^1.8.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "engines": {
    "node": ">=20"
  },
  "author": "wjun78",
  "build": {
    "appId": "io.github.wenjun78.meetingcopilot",
    "productName": "Cue",
    "asar": false,
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "renderer/**",
      "package.json",
      "!node_modules/onnxruntime-web/dist/*.map",
      "!node_modules/onnxruntime-web/dist/*jsep*",
      "!node_modules/onnxruntime-web/dist/*asyncify*",
      "!node_modules/onnxruntime-web/dist/*jspi*",
      "!node_modules/onnxruntime-web/dist/ort.all*",
      "!node_modules/onnxruntime-web/dist/ort.bundle*",
      "!node_modules/onnxruntime-web/dist/ort.webgpu*",
      "!node_modules/onnxruntime-web/dist/ort.webgl*",
      "!node_modules/onnxruntime-web/dist/ort.wasm.bundle*",
      "!node_modules/onnxruntime-web/dist/ort.js",
      "!node_modules/onnxruntime-web/dist/ort.mjs",
      "!node_modules/onnxruntime-web/dist/ort.min.*",
      "!node_modules/onnxruntime-web/dist/ort.wasm.js",
      "!node_modules/onnxruntime-web/dist/ort.wasm.mjs",
      "!node_modules/onnxruntime-web/dist/ort.wasm.min.mjs",
      "!node_modules/onnxruntime-web/lib/**",
      "!node_modules/onnxruntime-common/lib/**"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cue",
      "artifactName": "Cue-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Cue-${version}-portable.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Transcribe your side of the meeting.",
        "NSAudioCaptureUsageDescription": "Transcribe the other side of the meeting."
      }
    },
    "linux": {
      "target": "dir",
      "icon": "build/icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "wenjun78",
        "repo": "meeting_copilot"
      }
    ],
    "copyright": "Copyright © 2026 wjun78"
  }
}
